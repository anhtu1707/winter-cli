{
  "name": "winter-super-cli",
  "version": "2026.6.24",
  "description": "❄️ AI-Powered Development CLI with Interactive REPL",
  "type": "module",
  "main": "bin/winter.js",
  "types": "./winter.d.ts",
  "bin": {
    "winter": "bin/winter.js"
  },
  "files": [
    "bin/",
    "docs/",
    "extensions/vscode/",
    "!extensions/vscode/node_modules/**",
    "!extensions/vscode/*.vsix",
    "rules/",
    "scripts/audit-pack.js",
    "scripts/smoke-package.js",
    "scripts/prepublish-gate.js",
    "src/**/*.js",
    "!src/**/*.test.js",
    "resources/local/manifest.json",
    "resources/local/agents.md/",
    "resources/local/awesome-design-md/",
    "resources/local/codex/AGENTS.md",
    "resources/local/codex/models_cache.json",
    "resources/local/codex/plugins/",
    "resources/local/codex/rules/",
    "resources/local/codex/skills/",
    "resources/local/claude/plugins/",
    "resources/local/claude/skills/",
    "resources/local/karpathy-tools/",
    "resources/local/page-agent/",
    "resources/local/ecc/",
    "!resources/local/ecc/node_modules/**",
    "!resources/local/ecc/package-lock.json",
    "skills/",
    "memories/",
    "README.md",
    "WINTER.md",
    "CLAUDE.md",
    "design.md",
    "skill.md",
    "rule.md",
    "CHANGELOG.md",
    "winter.d.ts"
  ],
  "scripts": {
    "start": "node bin/winter.js",
    "dev": "node bin/winter.js",
    "test": "node --test src/**/*.test.js",
    "pack:audit": "node scripts/audit-pack.js",
    "smoke:package": "node scripts/smoke-package.js",
    "prepublish:gate": "node scripts/prepublish-gate.js",
    "desktop:compile": "cd vscode-main && npm run compile",
    "desktop:dev": "cd vscode-main && scripts\\code.bat",
    "desktop:build": "cd vscode-main && npm run compile",
    "desktop:package:win32": "cd vscode-main && npm run gulp vscode-win32-x64",
    "desktop:setup:win32": "cd vscode-main && npm run gulp vscode-win32-x64-system-setup",
    "desktop:setup:user:win32": "cd vscode-main && npm run gulp vscode-win32-x64-user-setup"
  },
  "keywords": [
    "cli",
    "ai",
    "coding",
    "assistant",
    "interactive",
    "repl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhtu1707/winter-cli.git"
  },
  "homepage": "https://github.com/anhtu1707/winter-cli#readme",
  "bugs": {
    "url": "https://github.com/anhtu1707/winter-cli/issues"
  },
  "author": "Winter CLI",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "glob": "^13.0.6"
  },
  "optionalDependencies": {
    "@colbymchenry/codegraph": "^0.7.12",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3"
  }
}
