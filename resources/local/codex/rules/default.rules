prefix_rule(pattern=["Set-Content", "-Path", "E:\\dev\\app\\winter\\src\\cli.js", "-Value", "const { program } = require('commander');\\nconst chalk = require('chalk');\\nconst fetch = require('node-fetch');\\n\\nconst logo = chalk.hex('#00aaff').bold(\\n   *   \\n  ***  \\n ***** \\n*******\\n ***** \\n  ***  \\n   *   \\n);\\n\\nprogram\\n  .name('winter')\\n  .description('CLI tool for Winter project with AI provider support')\\n  .version('0.1.0');\\n\\nprogram\\n  .command('say <message>')\\n  .description('Send a message to the AI provider (placeholder)')\\n  .action(async (message) => {\\n    console.log(logo);\\n    console.log(chalk.green('Sending to AI provider...'));\\n    try {\\n      const response = await fetch('https://api.example.com/ai', {\\n        method: 'POST',\\n        headers: { 'Content-Type': 'application/json' },\\n        body: JSON.stringify({ prompt: message })\\n      });\\n      const data = await response.json();\\n      console.log(chalk.cyan(data.reply ?? '[no reply]'));\\n    } catch (e) {\\n      console.error(chalk.red('Request failed'), e);\\n    }\\n  });\\n\\nprogram.parse(process.argv);", "-Encoding", "UTF8"], decision="allow")
